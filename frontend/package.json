{
  "name": "samurai-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "check": "npm run typecheck && npm test",
    "start": "node server/production.mjs",
    "test:server": "node --test tests/production-server.test.mjs"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@assistant-ui/react": "0.15.27",
    "@copilotkit/react-core": "1.79.0",
    "@copilotkit/runtime": "1.79.0",
    "@fontsource-variable/inter": "5.3.0",
    "@openuidev/react-lang": "1.0.1",
    "@paper-design/shaders-react": "0.0.81",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@vitejs/plugin-react": "5.0.4",
    "clsx": "2.1.1",
    "google-auth-library": "11.2.0",
    "liquid-glass-react": "1.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.7.0",
    "vite": "6.4.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
