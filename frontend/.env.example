# Local Vite proxy only. Obtain your signed user JWT from AgentOS OS Security.
# Keep this in ignored .env.local; never use VITE_ variables for credentials.
AGENTOS_USER_TOKEN=

# Production Node BFF / Cloud Run only (never VITE_). IAP restricts team access.
# Mount the private PEM through Secret Manager; do not commit a real key.
PUBLIC_ORIGIN=https://samurai-frontend-590733583260.asia-south1.run.app
AGENTOS_BACKEND_URL=https://samurai-backend-590733583260.asia-south1.run.app
IAP_AUDIENCE=/projects/590733583260/locations/asia-south1/services/samurai-frontend
AGENTOS_SIGNING_KEY=
PORT=8080

# Guest support is staged locally, not activated in production.
# Keep iap until docs/public-guest-access.md activation checks pass.
FRONTEND_AUTH_MODE=iap
