# Copy to .env. Never commit credentials.
# Required: generate a local bearer key with openssl rand -hex 32.
OS_SECURITY_KEY=
# Fill from root .env's POSTGRES_PASSWORD; URL-encode special characters.
DATABASE_URL=postgresql+psycopg://samurai:REPLACE_ME@127.0.0.1:54329/samurai
# Keep the local default. Cloud Run sets this to production and refuses to start
# unless both GOOGLE_API_KEY and JWT_VERIFICATION_KEY are non-empty.
SAMURAI_ENVIRONMENT=development
# Needed only when enabling/running the Gemini agent.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_INPUT_CHARS=20000
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=60
AGENT_TOOL_CALL_LIMIT=4
# Keep durable execution off until local Redis coordination is deliberately enabled.
# When true, REDIS_URL must remain a private loopback URL for this Samurai checkout.
QUEUE_ENABLED=false
REDIS_URL=redis://127.0.0.1:16379/0
# Immutable local workspace files. GCS remains disabled in this build.
STORAGE_BACKEND=local
STORAGE_ROOT=.samurai-storage
# Optional: public PEM key from Samurai's own os.agno.com JWT connection.
# When configured, signed JWTs replace shared-key authentication.
# Use a quoted multiline value when adding this to .env.
# JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----"
# Optional additional public PEM key for the Google-IAP frontend BFF signer.
# Keep JWT_VERIFICATION_KEY configured for Agno Live; this does not replace it.
# FRONTEND_JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----"

# Public guests remain disabled until migration 0005 and the durable queue are ready.
GUEST_ACCESS_ENABLED=false
